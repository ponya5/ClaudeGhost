# WAHA (WhatsApp HTTP API) Configuration
WAHA_API_URL=http://localhost:3000
WAHA_SESSION=default
TARGET_PHONE=1234567890@c.us
WAHA_ENABLED=true

# Autonomy Settings
DEFAULT_AFK_LEVEL=3

# Budget Settings
MAX_BUDGET_USD=5.00
BUDGET_PRESET=medium

# Claude CLI
CLAUDE_BINARY=claude
WORKING_DIRECTORY=.

# Timing
POLL_INTERVAL_SECONDS=3.0
HEARTBEAT_TIMEOUT_SECONDS=60.0
