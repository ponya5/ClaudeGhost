# =============================================================================
# ClaudeGhost Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Telegram Bot API
# -----------------------------------------------------------------------------
# 1. Open Telegram, search for @BotFather
# 2. Send /newbot, follow the prompts
# 3. Copy the FULL token (including colon and everything after it)
#    Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
#    NOT just: 1234567890
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID
# Get it from @userinfobot or see docs/TELEGRAM_SETUP.md
# Example: 123456789
TELEGRAM_CHAT_ID=your_chat_id_here

# Enable Telegram notifications (true/false)
TELEGRAM_ENABLED=true

# -----------------------------------------------------------------------------
# Autonomy Settings
# -----------------------------------------------------------------------------
# AFK Level (1-5): 1=Paranoid, 2=Auditor, 3=Manager, 4=Director, 5=GodMode
DEFAULT_AFK_LEVEL=3

# -----------------------------------------------------------------------------
# Budget Settings
# -----------------------------------------------------------------------------
MAX_BUDGET_USD=10.00
BUDGET_PRESET=medium

# -----------------------------------------------------------------------------
# Claude CLI
# -----------------------------------------------------------------------------
CLAUDE_BINARY=claude
WORKING_DIRECTORY=.

# -----------------------------------------------------------------------------
# Timing
# -----------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=3.0
HEARTBEAT_TIMEOUT_SECONDS=60.0
